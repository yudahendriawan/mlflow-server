# Copy to .env and set a strong password:
#   cp .env.example .env && sed -i '' "s/^POSTGRES_PASSWORD=.*/POSTGRES_PASSWORD=$(openssl rand -hex 24)/" .env
# Use URL-safe characters for the password (it is embedded in a connection URI).
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mlflow

# MLflow version (no "v" prefix). Must match a ghcr.io/mlflow/mlflow:v<version> tag.
MLFLOW_VERSION=3.17.2

# Host port bound on 127.0.0.1 (avoid 5000: macOS AirPlay Receiver).
MLFLOW_HOST_PORT=5050
